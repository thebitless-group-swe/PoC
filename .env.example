# URL base del provider LiteLLM (compatibile OpenAI)
LITELLM_BASE_URL=https://api.indirizzo-azienda.it/v1

# Modello da invocare
LITELLM_MODEL=gemma

# Non esporre mai al frontend
LITELLM_API_KEY=la_chiave

# Origini CORS accettate dal backend (in formato JSON)
CORS_ORIGINS=["http://localhost:5173"]
